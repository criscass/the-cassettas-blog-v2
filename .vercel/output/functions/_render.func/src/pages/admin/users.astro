---
import { desc } from "drizzle-orm";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import AdminUsers, { type AdminUser } from "@components/admin/AdminUsers.tsx";
import { db } from "@db/index";
import { user } from "@db/schema";

// SSR — reads the live user table and is admin-gated by src/middleware.ts.
export const prerender = false;

const rows = await db
	.select({
		id: user.id,
		name: user.name,
		email: user.email,
		role: user.role,
		status: user.status,
		createdAt: user.createdAt,
	})
	.from(user)
	.orderBy(desc(user.createdAt));

// Pending sign-ups first (the queue), then the rest. createdAt -> ISO string so
// it serializes cleanly across the island boundary.
const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2 } as const;
const users: AdminUser[] = rows
	.map((u) => ({ ...u, createdAt: u.createdAt.toISOString() }))
	.sort((a, b) => STATUS_ORDER[a.status] - STATUS_ORDER[b.status]);
---

<Layout title="Users" description="User approval queue">
	<Container>
		<div class="animate space-y-6">
			<h1 class="text-2xl font-semibold text-black dark:text-white">
				User approval
			</h1>
			<AdminUsers initialUsers={users} client:load />
		</div>
	</Container>
</Layout>
