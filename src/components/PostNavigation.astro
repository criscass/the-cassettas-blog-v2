---
import { cleanSlug } from "@lib/utils";
const { prevPost, nextPost, lang } = Astro.props;

function constructUrl(id: string, lang: string) {
	const slug = cleanSlug(id);
	return `${lang}/${slug}`;
}
---

<div class="grid grid-cols-2 gap-1.5 sm:gap-3">
	{
		prevPost?.id ? (
			<a
				href={constructUrl(prevPost?.id, lang)}
				class="group relative flex flex-nowrap rounded-xl border border-border px-4 py-3 pl-10 no-underline transition-colors duration-300 ease-in-out hover:border-accent/30 hover:bg-accent/5 focus-visible:border-accent/30 focus-visible:bg-accent/5"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					class="absolute left-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-accent group-focus-visible:stroke-accent"
				>
					<line
						x1="5"
						y1="12"
						x2="19"
						y2="12"
						class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
					/>
					<polyline
						points="12 5 5 12 12 19"
						class="translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
					/>
				</svg>
				<div class="flex items-center text-sm">{prevPost?.data.title}</div>
			</a>
		) : (
			<div class="invisible" />
		)
	}

	{
		nextPost?.id ? (
			<a
				href={constructUrl(nextPost?.id, lang)}
				class="group relative flex flex-grow flex-row-reverse flex-nowrap rounded-xl border border-border px-4 py-4 pr-10 no-underline transition-colors duration-300 ease-in-out hover:border-accent/30 hover:bg-accent/5 focus-visible:border-accent/30 focus-visible:bg-accent/5"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-accent group-focus-visible:stroke-accent"
				>
					<line
						x1="5"
						y1="12"
						x2="19"
						y2="12"
						class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
					/>
					<polyline
						points="12 5 19 12 12 19"
						class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
					/>
				</svg>
				<div class="flex items-center text-sm">{nextPost?.data.title}</div>
			</a>
		) : (
			<div class="invisible" />
		)
	}
</div>
