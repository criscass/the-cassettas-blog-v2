---
interface Props {
  type?: "default" | "info" | "warning" | "error";
}

const { type = "default" } = Astro.props;

let emoji = "💡";

if (type === "info") {
  emoji = "ℹ️";
} else if (type === "warning") {
  emoji = "⚠️";
} else if (type === "error") {
  emoji = "🚨";
}
---

<div class={`not-prose callout callout-${type}`}>
  <span class="emoji pointer-events-none select-none">{emoji}</span>
  <slot />
</div>

<style>
  .callout {
    @apply relative my-4 flex rounded-xl border-l-4 bg-surface/60 p-4 text-sm;
    @apply border border-border border-l-accent;
  }

  .emoji {
    @apply pr-3 text-xl;
  }

  .callout-info {
    @apply border-l-sky-500 dark:border-l-sky-400;
  }

  .callout-warning {
    @apply border-l-amber-500 dark:border-l-amber-400;
  }

  .callout-error {
    @apply border-l-rose-500 dark:border-l-rose-400;
  }
</style>
