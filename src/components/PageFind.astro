---
import Search from "astro-pagefind/components/Search";
---

<div
  id="backdrop"
  class="bg-[rgba(0,0,0,0.5)] invisible fixed left-0 top-0 z-50 flex h-screen w-full justify-center p-6 backdrop-blur-sm"
>
  <div
    id="pagefind-container"
    class="m-0 flex h-fit max-h-[80%] w-full max-w-screen-sm flex-col overflow-auto rounded-xl border border-border bg-surface p-2 px-4 py-3 shadow-lg"
  >
    <Search
      transition:persist
      id="search"
      className="pagefind-ui"
      uiOptions={{
        showImages: false,
        excerptLength: 15,
        resetStyles: false,
      }}
    />
    <div class="mr-2 pb-1 pt-4 text-right text-xs dark:prose-invert">
      Press <span class="prose text-xs dark:prose-invert"
        ><kbd class="">Esc</kbd></span
      > or click anywhere to close
    </div>
  </div>
</div>

<script is:inline>
  // The search button, backdrop and pagefind input are re-rendered on every
  // Astro View Transition navigation, so we must not cache element references
  // here (this inline script runs only once). Instead we delegate off `document`
  // — which survives swaps — and re-query elements each time. Previously the
  // listener was bound to the first-loaded button, so search only worked until
  // the first client-side navigation.
  function openPagefind() {
    const search = document.getElementById("search")?.querySelector("input");
    const backdrop = document.getElementById("backdrop");
    setTimeout(() => search?.focus(), 0);
    backdrop?.classList.remove("invisible");
    backdrop?.classList.add("visible");
  }

  function closePagefind() {
    const search = document.getElementById("search")?.querySelector("input");
    if (search) search.value = "";
    const backdrop = document.getElementById("backdrop");
    backdrop?.classList.remove("visible");
    backdrop?.classList.add("invisible");
  }

  document.addEventListener("click", (event) => {
    if (event.target.closest("#magnifying-glass")) {
      openPagefind();
    } else if (
      event.target.closest("#backdrop") &&
      !event.target.closest("#pagefind-container")
    ) {
      closePagefind();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    } else if (e.key === "Escape") {
      closePagefind();
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: "Geist", sans-serif;
    --pagefind-ui-primary: #9c7530;
    --pagefind-ui-text: #2b2620;
    --pagefind-ui-background: #efe9dd;
    --pagefind-ui-border: rgb(0 0 0 / 0.10);
    --pagefind-ui-tag: #f7f4ee;
  }

  .dark {
    --pagefind-ui-primary: #d8b167;
    --pagefind-ui-text: #f3efe7;
    --pagefind-ui-background: #17150f;
    --pagefind-ui-border: rgb(255 255 255 / 0.10);
    --pagefind-ui-tag: #0c0b0a;
  }

  #search input {
    font-weight: normal;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>
