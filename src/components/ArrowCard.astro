---
import type { CollectionEntry } from "astro:content";
import { cleanSlug } from "@lib/utils";

type Props = {
	entry: CollectionEntry<"blog">;
	lang: string;
};

const { entry } = Astro.props as {
	entry: CollectionEntry<"blog">;
};

const { lang } = Astro.props;
---

<a
	href={`/${lang}/${cleanSlug(entry.id)}`}
	class="not-prose group relative flex flex-nowrap rounded-xl border border-border px-4 py-3 pr-10 transition-colors duration-300 ease-in-out hover:border-accent/30 hover:bg-accent/5 focus-visible:border-accent/30 focus-visible:bg-accent/5"
>
	<div class="flex flex-1 flex-col truncate">
		<div class="font-semibold">
			{entry.data.title}
		</div>
		<div class="text-sm">
			{entry.data.description}
		</div>
	</div>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-accent group-focus-visible:stroke-accent"
	>
		<line
			x1="5"
			y1="12"
			x2="19"
			y2="12"
			class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
		></line>
		<polyline
			points="12 5 19 12 12 19"
			class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
		></polyline>
	</svg>
</a>
