---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import AuthStatus from "@components/auth/AuthStatus.tsx";
import { SITE } from "@consts";

const currentLocale = Astro.currentLocale ?? "it";
const otherLocale = currentLocale === "it" ? "en" : "it";
const { pathname } = Astro.url;

// Split the pathname into segments and replace currentLocale segments with otherLocale
const newPath = pathname
	.split("/")
	.map((segment) => (segment === currentLocale ? otherLocale : segment))
	.join("/") || `/${otherLocale}`;
---

<header>
	<Container>
		<div class="flex flex-wrap justify-between gap-y-2">
			<Link href={`/${currentLocale}`} underline={false}>
				<div class="text-2xl font-semibold">
					{SITE.TITLE}
				</div>
			</Link>
			<nav class="flex items-center gap-3 text-sm">
				<Link href={`/${currentLocale}/blog`}>blog</Link>

				<div class="flex items-center gap-1 text-xs">
					{
						currentLocale === "it" ? (
							<span class="font-medium text-accent">IT</span>
						) : (
							<Link href={newPath} underline={false}>
								<span class="opacity-70 transition-colors hover:text-accent">IT</span>
							</Link>
						)
					}
					<span class="opacity-30" aria-hidden="true">|</span>
					{
						currentLocale === "en" ? (
							<span class="font-medium text-accent">EN</span>
						) : (
							<Link href={newPath} underline={false}>
								<span class="opacity-70 transition-colors hover:text-accent">EN</span>
							</Link>
						)
					}
				</div>

				<button
					id="magnifying-glass"
					aria-label="Search"
					class="flex items-center justify-center rounded-lg border border-border bg-surface p-2 text-xs transition-colors duration-300 ease-in-out hover:border-accent/30 hover:bg-accent/5 hover:text-accent focus-visible:border-accent/30 focus-visible:bg-accent/5 focus-visible:text-accent"
				>
					<svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color: currentcolor;"
						><path
							fill-rule="evenodd"
							clip-rule="evenodd"
							d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
							fill="currentColor"></path></svg
					>
				</button>

				<AuthStatus lang={currentLocale === "en" ? "en" : "it"} client:only="react" />
			</nav>
		</div>
	</Container>
</header>
