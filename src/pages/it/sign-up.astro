---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import SignUpForm from "@components/auth/SignUpForm.tsx";
import { AUTH_STRINGS } from "@components/auth/authStrings";

const t = AUTH_STRINGS.it;
---

<Layout title={t.signUpTitle} description={t.signUpTitle}>
	<Container>
		<div class="animate mx-auto flex max-w-sm flex-col gap-6">
			<h1 class="text-2xl font-semibold text-black dark:text-white">{t.signUpTitle}</h1>
			<SignUpForm lang="it" client:load />
			<p class="text-sm text-black/70 dark:text-white/70">
				{t.haveAccount} <Link href="/it/sign-in">{t.signInLink}</Link>
			</p>
		</div>
	</Container>
</Layout>
