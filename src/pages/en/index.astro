---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, WHATSAPP_GROUPS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";
import hero_img from "../../assets/images/hero.jpg";

const blog = (await getCollection("blog"))
	.filter((post) => !post.data.draft && post.data.language === "en")
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
	<Container>
		<Image src={hero_img} alt="black and white of a smiley, happy cassetta's family" />
		<div class="space-y-16">
			<section>
				<article class="space-y-4">
					<span class="animate">
						<p>
							The term "rebooting" comes from the world of computing. The meaning varies depending on the context.
							Metaphorically, "rebooting" can be used to indicate a new beginning or a renewal in various aspects of life, such
							as changing careers, starting a project from scratch, or adopting new habits to improve one's well-being.
						</p>
						<p>
							After 15 years of stable and happy life, spent in a paradise among the Tuscan hills, the Cassetta family
							undergoes a drastic "reboot," moving to the Netherlands, changing careers, schools, language, and lifestyle.
						</p>
					</span>
				</article>
			</section>

			<section class="animate space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-y-2">
					<h2 class="font-semibold text-black dark:text-white">Latest posts</h2>
					<Link href="/it/blog"> See all posts </Link>
				</div>
				<ul class="not-prose flex flex-col gap-4">
					{
						blog.map((post) => (
							<li>
								<ArrowCard entry={post} lang="en" />
							</li>
						))
					}
				</ul>
			</section>

			<section class="animate space-y-4">
				<h2 class="text-2xl font-semibold text-black dark:text-white">Let's keep in touch</h2>
				<article>
					<p>
						Got something to say? We'd love to hear from you — send us a message and we'll get back to you.
					</p>
				</article>
				<a
					href="/en/contact"
					class="not-prose inline-block rounded-lg border border-accent px-4 py-2 font-medium text-accent no-underline transition-colors hover:bg-accent/10"
				>
					Contact us
				</a>
				<article>
					<p>
						Want to know when we publish a new post? Join our WhatsApp group — we only use it to announce new posts.
						You'll be let in after a quick approval.
					</p>
				</article>
				<a
					href={WHATSAPP_GROUPS.en}
					target="_blank"
					rel="noopener"
					class="not-prose inline-block rounded-lg bg-accent px-4 py-2 font-medium text-ink no-underline transition-opacity hover:opacity-90"
				>
					Join the WhatsApp group
				</a>
			</section>
		</div>
	</Container>
</Layout>
