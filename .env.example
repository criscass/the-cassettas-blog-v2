# Copy to `.env` and fill in. `.env` is gitignored.

# Database — Neon serverless Postgres connection string
# Create a project at https://neon.tech and paste its pooled connection string.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=          # random 32+ char string: `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:4321   # site base URL (prod: https://your-domain)

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Left blank, Google sign-in is simply disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Added in later phases ---
# Vercel Blob (Phase 5, image upload for Keystatic)
# BLOB_READ_WRITE_TOKEN=
# Keystatic GitHub App (Phase 5) — production only; local dev uses `local` storage.
# Easiest setup: temporarily set `kind: 'github'` in keystatic.config.ts, run dev,
# visit http://localhost:4321/keystatic/setup — Keystatic creates the GitHub App
# and writes these values to .env. Copy them to the Vercel dashboard.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=           # random 32+ char string: `openssl rand -hex 32`
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=   # optional; lets the UI link to the app install page

# Outgoing email via Resend (https://resend.com — free tier): admin
# notifications (new pending users + new comments) AND the verification email
# sent to new email/password sign-ups. Left blank, sending is skipped and the
# verification link is logged to the server console instead.
# RESEND_API_KEY=
# NOTIFY_EMAIL_TO=             # your inbox (the Resend account owner's address)
# NOTIFY_EMAIL_FROM=           # defaults to onboarding@resend.dev, which only
#                              # delivers to the Resend account owner — fine for
#                              # admin notifications but NOT for verification
#                              # emails to real users: those need a sender on a
#                              # domain verified in Resend.
